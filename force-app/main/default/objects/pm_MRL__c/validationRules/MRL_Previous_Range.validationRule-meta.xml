<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MRL_Previous_Range</fullName>
    <active>true</active>
    <description>Previous MRL, when provided, must be between 1 and 9 inclusive.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Previous_MRL__c)), OR(Previous_MRL__c &lt; 1, Previous_MRL__c &gt; 9))</errorConditionFormula>
    <errorDisplayField>Previous_MRL__c</errorDisplayField>
    <errorMessage>Previous MRL must be between 1 and 9.</errorMessage>
</ValidationRule>
