<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MRL_Current_Range</fullName>
    <active>true</active>
    <description>Current MRL must be between 1 and 9 inclusive.</description>
    <errorConditionFormula>OR(Current_MRL__c &lt; 1, Current_MRL__c &gt; 9)</errorConditionFormula>
    <errorDisplayField>Current_MRL__c</errorDisplayField>
    <errorMessage>Current MRL must be between 1 and 9.</errorMessage>
</ValidationRule>
