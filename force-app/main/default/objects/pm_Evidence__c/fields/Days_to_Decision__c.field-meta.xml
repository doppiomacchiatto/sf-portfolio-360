<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_to_Decision__c</fullName>
    <description>KPI #9: Days from evidence provided to decision. Lower is better — rapid response to adverse evidence is the target.</description>
    <formula>IF(AND(NOT(ISBLANK(Decision_Date__c)), NOT(ISBLANK(Evidence_Provided_Date__c))), Decision_Date__c - Evidence_Provided_Date__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Days to Decision</label>
    <precision>5</precision>
    <scale>0</scale>
    <type>Number</type>
</CustomField>
