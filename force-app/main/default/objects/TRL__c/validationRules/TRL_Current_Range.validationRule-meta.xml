<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TRL_Current_Range</fullName>
    <active>true</active>
    <description>Current TRL must be between 1 and 9 inclusive.</description>
    <errorConditionFormula>OR(Current_TRL__c &lt; 1, Current_TRL__c &gt; 9)</errorConditionFormula>
    <errorDisplayField>Current_TRL__c</errorDisplayField>
    <errorMessage>Current TRL must be between 1 and 9.</errorMessage>
</ValidationRule>
