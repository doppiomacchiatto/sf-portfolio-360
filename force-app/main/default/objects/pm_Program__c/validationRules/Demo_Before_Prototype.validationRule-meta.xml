<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Demo_Before_Prototype</fullName>
    <active>true</active>
    <description>Successful Demo Date cannot be earlier than First Prototype Date.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Successful_Demo_Date__c)), NOT(ISBLANK(First_Prototype_Date__c)), Successful_Demo_Date__c &lt; First_Prototype_Date__c)</errorConditionFormula>
    <errorDisplayField>Successful_Demo_Date__c</errorDisplayField>
    <errorMessage>Successful Demo Date cannot be before First Prototype Date.</errorMessage>
</ValidationRule>
