<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TRL_Previous_Range</fullName>
    <active>true</active>
    <description>Previous TRL, when provided, must be between 1 and 9 inclusive.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Previous_TRL__c)), OR(Previous_TRL__c &lt; 1, Previous_TRL__c &gt; 9))</errorConditionFormula>
    <errorDisplayField>Previous_TRL__c</errorDisplayField>
    <errorMessage>Previous TRL must be between 1 and 9.</errorMessage>
</ValidationRule>
