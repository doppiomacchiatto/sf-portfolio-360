<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>KPI #6: Tracks Technology Readiness Level assessments for each program. Related list on pm_Program__c. Each record represents a point-in-time TRL assessment for a critical technology element.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <compactLayoutAssignment>TRL_Compact</compactLayoutAssignment>
    <label>TRL Assessment</label>
    <nameField>
        <label>TRL Assessment Name</label>
        <type>AutoNumber</type>
        <displayFormat>TRL-{0000}</displayFormat>
    </nameField>
    <pluralLabel>TRL Assessments</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
