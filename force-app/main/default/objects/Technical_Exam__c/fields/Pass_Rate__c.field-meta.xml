<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pass_Rate__c</fullName>
    <description>KPI #8: Percentage of exam criteria passed (Exams Passed / Exams Administered × 100).</description>
    <formula>IF(Exams_Administered__c &gt; 0, (Exams_Pass__c / Exams_Administered__c) * 100, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Pass Rate (%)</label>
    <precision>5</precision>
    <scale>1</scale>
    <type>Number</type>
</CustomField>
